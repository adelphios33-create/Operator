<configs>
<append xpath="/windows">

	<!-- ============ BAUPLAN ============ -->
	<window name="bauplanFenster" pos="-590, 412" width="1180" height="824" anchor="CenterCenter" controller="Bauplan, Bauplan" cursor_area="true">
		<panel name="header" height="43" depth="1" backgroundspritename="ui_game_panel_header">
			<sprite depth="2" name="windowIcon" style="icon32px" pos="4,-5" sprite="ui_game_symbol_coin"/>
			<label depth="2" pos="42,-6" width="560" height="32" font_size="32" color="[white]" justify="left" text="BAUPLAN – Gebäude kopieren und einfügen" />
			<label depth="2" pos="1170,-8" width="240" height="32" font_size="24" color="200,200,200" justify="right" pivot="topright" text="{bpmodus}" />
		</panel>
		<rect name="content" pos="0,-46" width="1180" height="778" depth="1">
			<sprite depth="8" name="backgroundMain" sprite="menu_empty3px" pos="0,0" width="1180" height="778" color="[black]" type="sliced" fillcenter="false" />
			<sprite depth="1" color="[darkGrey]" type="sliced" width="1180" height="778" />

			<!-- Vorschaubild des gewählten Gebäudes -->
			<label depth="3" pos="842,-10" width="324" height="30" font_size="28" color="255,170,90" justify="left" text="{bpvorschau}" />
			<sprite depth="2" pos="840,-42" width="328" height="328" color="26,26,26" type="sliced" />
			<texture name="bpBild" depth="4" pos="844,-46" width="320" height="320" visible="{bpbildan}" />
			<texture name="bpTex" depth="4" pos="844,-46" width="320" height="320" material="Materials/Transparent Colored" globalopacity="false" visible="{bptexan}" />
			<label depth="5" pos="846,-338" width="316" height="26" font_size="20" color="[white]" justify="center" effect="outline" text="{bptexname}" />
			<label depth="3" pos="850,-180" width="308" height="60" font_size="20" color="160,160,160" justify="center" text="{bpbildtext}" />
			<simplebutton name="btnBoden" depth="3" pos="840,-384" width="328" height="38" font_size="20" caption="Boden reparieren" />
			<simplebutton name="btnAuffuellen" depth="3" pos="840,-428" width="162" height="38" font_size="18" caption="Auffüllen: Erde" />
			<simplebutton name="btnAsphalt" depth="3" pos="1006,-428" width="162" height="38" font_size="18" caption="Auffüllen: Asphalt" />
			<label depth="3" pos="842,-472" width="326" height="90" font_size="16" color="180,180,180" justify="left" text="Ecke 1 unten in der Grube, Ecke 2 oben auf Straßenhöhe, 2x drücken. Erde: Löcher werden Erde. Asphalt: Löcher Erde, oberste Schicht Asphalt (Straßen)." />
			<label depth="3" pos="842,-566" width="324" height="28" font_size="24" color="255,170,90" justify="left" text="Fläche füllen (Fundament)" />
			<simplebutton name="btnMaterial" depth="3" pos="840,-598" width="162" height="38" font_size="18" caption="Material: Beton" />
			<simplebutton name="btnFuellen" depth="3" pos="1006,-598" width="162" height="38" font_size="18" caption="Fläche füllen" />
			<simplebutton name="btnTexZurueck" depth="3" pos="840,-642" width="40" height="38" font_size="26" caption="&lt;" />
			<simplebutton name="btnTextur" depth="3" pos="884,-642" width="240" height="38" font_size="17" caption="Textur: Standard" />
			<simplebutton name="btnTexVor" depth="3" pos="1128,-642" width="40" height="38" font_size="26" caption="&gt;" />
			<simplebutton name="btnTexGruppe" depth="3" pos="840,-686" width="162" height="38" font_size="17" caption="Gruppe: Alle" />
			<textfield name="txtTextur" depth="3" pos="1006,-686" width="162" height="38" font_size="20" character_limit="30" />
			<label depth="3" pos="842,-730" width="326" height="44" font_size="15" color="180,180,180" justify="left" text="Höhe des Rahmens = Dicke. &lt; &gt; wählt die Textur, Textur anklicken = Standard, Feld rechts = suchen. Füllen 2x drücken." />

			<!-- 1. Markierung speichern -->
			<label depth="3" pos="14,-10" width="400" height="30" font_size="28" color="255,170,90" justify="left" text="1. Markierte Fläche speichern" />
			<sprite depth="2" pos="10,-42" width="820" height="40" color="26,26,26" type="sliced" />
			<label depth="3" pos="18,-48" width="804" height="28" font_size="20" color="[white]" justify="left" text="{bpmarkierung}" />
			<label depth="3" pos="14,-98" width="80" height="30" font_size="24" color="200,200,200" justify="left" text="Name" />
			<textfield name="txtName" depth="3" pos="84,-94" width="420" height="40" font_size="26" character_limit="48" />
			<simplebutton name="btnKopieren" depth="3" pos="514,-94" width="312" height="40" font_size="24" caption="Kopieren und speichern" />
			<simplebutton name="btnHoeherUnten" depth="3" pos="14,-142" width="150" height="36" font_size="18" caption="+1 nach unten" />
			<simplebutton name="btnHoeherOben" depth="3" pos="170,-142" width="150" height="36" font_size="18" caption="+1 nach oben" />
			<simplebutton name="btnMarkLoeschen" depth="3" pos="326,-142" width="150" height="36" font_size="18" caption="Markierung weg" />
			<simplebutton name="btnLeeren" depth="3" pos="482,-142" width="190" height="36" font_size="18" caption="Gebäude entfernen" />
			<simplebutton name="btnLeerenAlles" depth="3" pos="678,-142" width="148" height="36" font_size="18" caption="Alles leeren" />
			<label depth="3" pos="14,-184" width="812" height="24" font_size="18" color="180,180,180" justify="left" text="Gebäude entfernen = alles im Rahmen weg, Erde bleibt. Alles leeren = auch Erde und Stein. Je 2x drücken, Rückgängig geht." />

			<!-- 2. Gebäude auswählen und einfügen -->
			<label depth="3" pos="14,-218" width="400" height="30" font_size="28" color="255,170,90" justify="left" text="2. Gebäude einfügen" />
			<label depth="3" pos="826,-222" width="200" height="26" font_size="22" color="200,200,200" justify="right" pivot="topright" text="{bpanzahl}" />
			<simplebutton name="btnFilter" depth="3" pos="14,-254" width="300" height="38" font_size="22" caption="Zeigen: Alle" />
			<label depth="3" pos="324,-258" width="70" height="30" font_size="22" color="200,200,200" justify="left" text="Suche" />
			<textfield name="txtSuche" depth="3" pos="394,-254" width="290" height="38" font_size="24" character_limit="40" />
			<simplebutton name="btnNeuLaden" depth="3" pos="694,-254" width="132" height="38" font_size="20" caption="Neu einlesen" />
			<simplebutton name="btnL0" depth="3" pos="14,-302" width="500" height="36" font_size="22" caption="-" />
			<simplebutton name="btnL1" depth="3" pos="14,-342" width="500" height="36" font_size="22" caption="-" />
			<simplebutton name="btnL2" depth="3" pos="14,-382" width="500" height="36" font_size="22" caption="-" />
			<simplebutton name="btnL3" depth="3" pos="14,-422" width="500" height="36" font_size="22" caption="-" />
			<simplebutton name="btnL4" depth="3" pos="14,-462" width="500" height="36" font_size="22" caption="-" />
			<simplebutton name="btnL5" depth="3" pos="14,-502" width="500" height="36" font_size="22" caption="-" />
			<simplebutton name="btnL6" depth="3" pos="14,-542" width="500" height="36" font_size="22" caption="-" />
			<simplebutton name="btnL7" depth="3" pos="14,-582" width="500" height="36" font_size="22" caption="-" />
			<simplebutton name="btnZurueck" depth="3" pos="14,-626" width="60" height="36" font_size="28" caption="&lt;" />
			<label depth="3" pos="80,-630" width="374" height="30" font_size="22" color="200,200,200" justify="center" text="{bpseite}" />
			<simplebutton name="btnVor" depth="3" pos="454,-626" width="60" height="36" font_size="28" caption="&gt;" />

			<sprite depth="2" pos="524,-302" width="302" height="112" color="26,26,26" type="sliced" />
			<simplebutton name="btnZombies" depth="3" pos="524,-420" width="302" height="36" font_size="20" caption="Zombies: AUS (keine)" />
			<label depth="3" pos="532,-306" width="288" height="104" font_size="18" color="[white]" justify="left" text="{bpauswahl}" />
			<simplebutton name="btnDrehen" depth="3" pos="524,-462" width="302" height="36" font_size="22" caption="Drehen: 0°" />
			<simplebutton name="btnLuft" depth="3" pos="524,-502" width="302" height="36" font_size="20" caption="Fläche freiräumen: AN" />
			<simplebutton name="btnKeller" depth="3" pos="524,-542" width="302" height="36" font_size="20" caption="Keller einsenken: AN" />
			<simplebutton name="btnPlatzieren" depth="3" pos="524,-584" width="302" height="40" font_size="24" caption="Platzieren (Werkzeug)" />
			<simplebutton name="btnAbbrechen" depth="3" pos="524,-626" width="148" height="36" font_size="20" caption="Platz. beenden" />
			<simplebutton name="btnAblage" depth="3" pos="678,-626" width="148" height="36" font_size="20" caption="Zwischenablage" />
			<simplebutton name="btnLoeschen" depth="3" pos="378,-670" width="150" height="38" font_size="20" caption="Löschen" />

			<label depth="3" pos="14,-672" width="360" height="40" font_size="18" color="255,220,120" justify="left" text="{bpmeldung}" />
			<simplebutton name="btnRueckgaengig" depth="3" pos="540,-670" width="150" height="38" font_size="20" caption="Rückgängig" />
			<simplebutton name="btnSchliessen" depth="3" pos="698,-670" width="128" height="38" font_size="22" caption="Schließen" />
		</rect>
	</window>

</append>
</configs>

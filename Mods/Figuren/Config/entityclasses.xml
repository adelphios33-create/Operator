<configs>
  <append xpath="/entity_classes">

    <!-- Grundlage aller Figuren: steht, bewegt sich nicht, nimmt keinen Schaden. Aussehen kommt von den Haendler-Modellen. -->
    <entity_class name="figurVorlage">
      <property name="Class" value="EntityFigur, Figuren" />
      <property name="UserSpawnType" value="None" />
      <property name="Tags" value="entity,npc,human" />
      <property name="EntityType" value="Player" />
      <property name="Faction" value="whiteriver" />
      <property name="Mesh" value="@:Entities/Traders/Prefabs/TraderJoel.prefab" />
      <property name="AvatarController" value="AvatarNpcController" />
      <property name="ModelType" value="Npc" />
      <property name="HasRagdoll" value="false" />
      <property name="Prefab" value="NPC" />
      <property name="Parent" value="Players" />
      <property name="PhysicsBody" value="Player" />
      <property name="Weight" value="70" />
      <property name="LookAtAngle" value="60" />
      <property name="NPCID" value="figur" />
      <property name="IsEnemyEntity" value="false" />
      <property name="WalkType" value="7" />
      <property name="SurfaceCategory" value="organic" />
      <property name="MaxViewAngle" value="180" />
      <property name="MoveSpeed" value="0" />
      <property name="MoveSpeedAggro" value="0, 0" />
      <property name="MoveSpeedPanic" value="0" />
      <property name="TimeStayAfterDeath" value="180" />
      <property name="ParticleOnDeath" value="blood_death" />
      <property name="HasDeathAnim" value="true" />
      <effect_group name="Base Effects">
        <passive_effect name="HealthMax" operation="base_set" value="100000" />
      </effect_group>
    </entity_class>

    <entity_class name="figurJoel" extends="figurVorlage">
      <property name="Mesh" value="@:Entities/Traders/Prefabs/TraderJoel.prefab" />
    </entity_class>
    <entity_class name="figurJen" extends="figurVorlage">
      <property name="Mesh" value="@:Entities/Traders/Prefabs/TraderJen.prefab" />
    </entity_class>
    <entity_class name="figurBob" extends="figurVorlage">
